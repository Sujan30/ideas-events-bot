# Discord Developer Portal (discord.com/developers/applications)
# -> Your App -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Right-click the #announcements channel in Discord (Developer Mode must be
# enabled in Discord Settings -> Advanced) -> Copy Channel ID
DISCORD_CHANNEL_ID=

# openrouter.ai -> sign up -> Keys -> Create Key
OPENROUTER_API_KEY=

# Pick a current free text model from https://openrouter.ai/models?max_price=0
# e.g. meta-llama/llama-3.3-70b-instruct:free (verify it's still free/live)
OPENROUTER_MODEL=

# Google Cloud service account JSON key, as a single-line JSON string.
# See README.md for how to create this.
GOOGLE_SERVICE_ACCOUNT_JSON=

# The Sheet ID from the events Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/{THIS_PART}/edit
GOOGLE_SHEET_ID=

# Tab name within the spreadsheet (defaults to "Sheet1" if unset)
GOOGLE_SHEET_NAME=
